# Version control
.git/
.gitignore
.gitattributes

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
.opencode/

# Environment files (secrets — injected at runtime via docker-compose)
.env
.env.*
!.env.example

# Database files (use volume mount instead)
*.db
*.sqlite
*.sqlite3

# Audit / documentation artifacts (not needed at runtime)
AUDIT_ARTIFACTS/
PROJECT_VALIDATION_REPORT.md
LICENSE
README.md

# OS files
.DS_Store
Thumbs.db
ehthumbs.db

# Test files (not needed in production image)
test_*.py
pytest.ini

# Misc
nul
*.log
