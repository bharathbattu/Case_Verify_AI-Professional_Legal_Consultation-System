# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Google Gemini AI API Key (REQUIRED)
GEMINI_API_KEY=your_gemini_api_key_here

# Environment setting
ENVIRONMENT=development

# Database URL (defaults to sqlite:///./case_verify.db if not set)
# DATABASE_URL=sqlite:///./case_verify.db

# Cookie signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
COOKIE_SECRET=change_me_to_a_random_secret

# Admin user setup (used only by init_database.py)
# If not set, a secure random password will be generated
# ADMIN_PASSWORD=YourStr0ngP@ssword
# ADMIN_EMAIL=admin@caseverify.ai

# Docker host port mapping (defaults to 8501)
# HOST_PORT=8501

# Email export settings (optional)
# SENDER_EMAIL=your_email@gmail.com
# SENDER_PASSWORD=your_app_password
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
